---
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";
import tedxPoster from "@/assets/indexbg.png";
---
<main class="bg-cover bg-center bg-no-repeat mt-0 pt-0" style={`background-image: url(${tedxPoster.src})`}>
  <div class="flex items-end justify-center min-h-[calc(100vh-3rem)]">
    <div class="text-center">
      <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center w-full max-w-xl mx-auto">
        <Link
          href="https://www.instagram.com/tedxakitaintlu"
          target="_blank"
          class="w-full flex gap-1 items-center justify-center"
          rel="noopener">
          <Icon class="text-white w-5 h-5" name="simple-icons:instagram" />
          Check for news!
        </Link>
      </div>
      <p class="text-3xl mt-2 mb-4 text-slate-600 max-w-xl">
        "Ideas worth spreading."
      </p>
      </div>
    </div>
  </div>
</main>