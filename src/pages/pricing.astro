---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import PricingCard from "@/components/pricing.astro";

const pricing = [
    {
    name: "一般用申込リンク",
    price: "?円",
    popular: false,
    features: [],
    button: {
      text: "申し込み",
      link: "/",
    },
  },
  {
    name: "AIU学部生・院生・教職員リンク",
    price: "?円",
    popular: true,
    features: [],
    button: {
      text: "申し込み",
      link: "#",
    },
  },
  {
    name: "招待客リンク",
    price: "?円",
    popular: false,
    features: [],
    button: {
      text: "申し込み",
      link: "/contact",
    },
  },
];
---

<Layout title="Pricing">
  <Container>
    <Sectionhead>
      <Fragment slot="title">チケット情報</Fragment>
      <Fragment slot="desc">
        支払いは当日か銀行振り込みでお願いします。
      </Fragment>
    </Sectionhead>

    <div
      class="grid md:grid-cols-3 gap-10 mx-auto max-w-(--breakpoint-lg) mt-12">
      {pricing.map((item) => <PricingCard plan={item} />)}
    </div>
  </Container>
</Layout>
