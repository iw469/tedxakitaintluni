---
// @ts-ignore
import { Picture } from "astro:assets";
import alumni from "@/assets/Alumni.jpg";
import accessmap from "@/assets/accessmap.png";
import { Icon } from "astro-icon/components";

const locale = Astro.props.lang ?? "ja";
const isEn = locale === "en";
---
<div class="mt-16 md:mt-1.5 mb-12">
<h2 id="route" class="text-4xl lg:text-5xl font-bold lg:tracking-tight ml-8 text-orange-400">
    {isEn ? "Venue" : "会場案内"}
</h2>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-2 md:gap-4 mt-8 items-stretch px-2 sm:px-2 md:px-0">
    <!-- Left: Info Box (moved) -->
    <div class="order-2 lg:order-1 bg-gray-50 rounded-lg shadow-lg p-6 text-left h-96 md:h-[520px] overflow-y-auto">
        <h3 class="text-3xl font-bold mb-4 text-gray-800">{isEn ? "Access" : "行き方"}</h3>
        <div class="space-y-3 text-gray-700 text-sm md:text-base">

            <div>
                <span class="text-xl md:text-xl font-bold">{isEn ? "[Venue]" : "【場所】"}</span>
                <span class="text-xl md:text-base font-semibold ml-2">{isEn ? "Akita International University Alumni Hall" : "国際教養大学アラムナイホール"}</span><br/>
                <span class="text-xl md:text-base font-semibold ml-2">{isEn ? "193-2 Oku-Tsubakidai, Yuwa Tsubakigawa, Akita, 010-1211" : "〒010-1211 秋田県秋田市雄和椿川字奥椿岱 193-2"}</span>
            </div>
            
            <div class="pt-0">
                <Picture
                    src={accessmap}
                    alt="Access Map"
                    widths={[320, 480, 640]}
                    sizes="(max-width: 768px) calc(100vw - 48px), 320px"
                    loading="lazy"
                    format="avif"
                    class="w-full max-w-sm h-auto object-contain rounded-md"
                />
            </div>
            <div>
                <p class="text-sm md:text-sm font-medium text-gray-700 my-0 -mt-1 -mb-1">{isEn ? "(Please check bus timetables via the links below.)" : "(バスの時刻表は下のリンクを参考してください。)"}</p>
                <p class="font-bold">{isEn ? "■ Akita Station to AEON Mall Akita" : "◾️秋田駅〜イオンモール秋田"}</p>
                <p class="mt-1">{isEn ? "Direct shuttle bus timetable (Akita Station East Exit to AEON Mall Akita)" : "直通シャトルバス時刻表（秋田駅東口〜イオンモール秋田）"}</p>
                <a href="https://akita.aeonmall.jp/access" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline break-all">https://akita.aeonmall.jp/access</a>
                <p class="mt-2">{isEn ? "Akita Chuo Kotsu timetable search (Routes 2 and 3)" : "秋田中央交通時刻表検索(ルート②③)乗車時刻検索"}</p>
                <a href="https://www.akita-chuoukotsu.co.jp/busstop-search.html" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline break-all">https://www.akita-chuoukotsu.co.jp/busstop-search.html</a>
            </div>
            <div>
                <p class="font-bold">{isEn ? "■ AEON Mall Akita to AIU" : "◾️イオンモール秋田〜国際教養大学"}</p>
                <p class="mt-1">{isEn ? "AIU Line timetable (AEON Mall Akita to AIU)" : "国際教養大学線（イオンモール秋田〜国際教養大学）時刻表"}</p>
                <a href="https://www.akita-chuoukotsu.co.jp/aiu.html" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline break-all">https://www.akita-chuoukotsu.co.jp/aiu.html</a>
            </div>
        </div>
    </div>
    <!-- Middle: Map -->
    <div class="order-3 lg:order-2 flex justify-center items-stretch w-full min-w-0 h-96 md:h-[520px]">
        <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3073.0223960119774!2d140.19556557571264!3d39.62669957157756!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x5f8fc0bcd4a7ee17%3A0xff1cc20ab98f7aaa!2sAkita%20International%20University!5e0!3m2!1sen!2sjp!4v1774932462987!5m2!1sen!2sjp"
            class="w-full h-full border-0 rounded-md"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
    </div>

    <!-- Right: Image (moved) -->
    <div class="order-1 lg:order-3 flex justify-end items-center w-full min-w-0 h-96 md:h-[520px]">
        <Picture
            src={alumni}
            alt="Alumni Hall Picture"
            widths={[200, 400, 600]}
            sizes="(max-width: 768px) calc(100vw - 32px), 50vw"
            loading="eager"
            format="avif"
                class="w-auto max-w-full h-full object-contain"
        />
    </div>
</div>