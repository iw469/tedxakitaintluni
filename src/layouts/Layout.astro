---
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import {
  alternateLocale,
  defaultLocale,
  detectLocale,
  localizePath,
} from "@/utils/i18n";
import "@fontsource-variable/inter/index.css";

import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const siteUrl = Astro.site?.toString();
const canonicalURL = siteUrl
  ? new URL(Astro.url.pathname, siteUrl).toString()
  : undefined;

const resolvedImageWithDomain = siteUrl
  ? new URL("/opengraph.jpg", siteUrl).toString()
  : undefined;

const { title, description, noindex = false, structuredData } = Astro.props;
const locale = detectLocale(Astro.url.pathname);
const alternateLocaleCode = alternateLocale(locale);

const supportsLocalizedAlternate = !Astro.url.pathname.startsWith("/blog");

const selfLocalizedPath = localizePath(Astro.url.pathname, locale);
const alternateLocalizedPath = localizePath(Astro.url.pathname, alternateLocaleCode);
const defaultLocalizedPath = localizePath(Astro.url.pathname, defaultLocale);

const localeHref = siteUrl
  ? new URL(selfLocalizedPath, siteUrl).toString()
  : undefined;
const alternateLocaleHref = siteUrl
  ? new URL(alternateLocalizedPath, siteUrl).toString()
  : undefined;
const defaultLocaleHref = siteUrl
  ? new URL(defaultLocalizedPath, siteUrl).toString()
  : undefined;

const structuredDataList = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];

const makeTitle = title
  ? title + " | " + "Tedxakitaintluni"
  : "TEDxAkitaIntlU | TEDx Akita International University Event";

const seoDescription =
  description ??
  "TEDxAkitaIntlU is the TEDx event at Akita International University in Japan, sharing ideas worth spreading through talks, workshops, and community events.";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- <link rel="preload" as="image" href={src} alt="Hero" /> -->
    <SEO
      title={makeTitle}
      description={seoDescription}
      canonical={canonicalURL}
      twitter={{
        creator: "@tedxakitaintluni",
        site: "tedxakitaintluni",
        card: "summary_large_image",
      }}
      openGraph={
        canonicalURL && resolvedImageWithDomain
          ? {
              basic: {
                url: canonicalURL,
                type: "website",
                title: makeTitle,
                image: resolvedImageWithDomain,
              },
              image: {
                alt: "Homepage Screenshot",
              },
            }
          : undefined
      }
    />
    {
      noindex && (
        <>
          <meta name="robots" content="noindex, nofollow" />
          <meta name="googlebot" content="noindex, nofollow" />
        </>
      )
    }
    {
      supportsLocalizedAlternate && localeHref && (
        <link rel="alternate" hreflang={locale} href={localeHref} />
      )
    }
    {
      supportsLocalizedAlternate && alternateLocaleHref && (
        <link
          rel="alternate"
          hreflang={alternateLocaleCode}
          href={alternateLocaleHref}
        />
      )
    }
    {
      supportsLocalizedAlternate && defaultLocaleHref && (
        <link rel="alternate" hreflang="x-default" href={defaultLocaleHref} />
      )
    }
    {
      structuredDataList.map((schema) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      ))
    }
  </head>
  <body>
    <Navbar locale={locale} />
    <slot />
    <Footer />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
