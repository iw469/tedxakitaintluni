---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import lastYear from "@/assets/last_year.jpg";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import TedxTeam from "@/components/tedxTeam.astro"
import GandF from "@/assets/GandF.jpg"
import ST from "@/assets/ST.png"
import TG from "@/assets/T&G.jpg"

// Filter team entries with 'draft: false' & date before current date
const itemsGF = [
  { label: "【役目】", value: "\n・協賛企業様を集める\n・協賛企業様や大学との連絡\n・その他外部の方との連絡" },
  { label: "【チームリーダーから】", value: "まだ" },
];

const itemsS = [
  { label: "【役目】", value: "\n・原稿・ワークショップ作りのサポート\n・抑揚・表情などを含めたTalk練習のサポート\n・日英・英日翻訳" },
  { label: "【チームリーダーから】", value: "スピーカーチームでは、スピーカー様のお話を整理し、自分の提案を分かりやすく伝えます。自身の言語能力を磨きつつイベントの華を咲かせる影の立役者です。" },
];

const itemsTG = [
  { label: "【役目】", value: "\n・ウェブサイトやインスタグラムの運用 \n・プロモーションビデオの作成\n・イベントのグッズやポスターの作成" },
  { label: "【チームリーダーから】", value: "まだ" },
];

const publishedTeamMembers = await getCollection("team", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});
---

<Layout title="About">
  <Container>
    <Sectionhead>
      <Fragment slot="title">TEDxAkitaIntlUとは</Fragment>
      <Fragment slot="desc"></Fragment>
    </Sectionhead>

    <div class="mt-16 md:mt-1.5 mb-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-8 mt-8 items-center px-4 sm:px-2 md:px-0">
        <!-- Left: Image -->
        <div class="flex justify-center items-center w-full min-w-0">
          <Picture
            src={lastYear}
            alt="Tedx Poster"
            widths={[200, 400, 600]}
            sizes="(max-width: 768px) calc(100vw - 32px), 50vw"
            loading="eager"
            format="avif"
            class="w-auto max-w-full h-auto object-contain"
          />
        </div>

        <!-- Right: Info Box -->
        <div class="bg-gray-50 rounded-lg shadow-lg p-6 text-left">
          <h3 class="text-3xl font-bold mb-4 text-gray-800">私たちに関して</h3>
          <p class="space-y-3 text-gray-700 text-lg">
            「秋⽥でイベントを⾏う」ことをモットーとした国際教養大学の学生団体。<br/>
            2018 年から過去 7 回TEDxイベントを開催し、国際教養大学生のみでイベントを運営している。<br/>
            「陸の孤島」と称され閉鎖的になりがちな国際教養大学を秋田のコミュニティと繋ぐこと、秋田と世界を繋ぐ架け橋になることを目的としている。
          </p>
        </div>
      </div>
    </div>
    <TedxTeam heading="General & Finance Team" image={GandF} items={itemsGF} teamMembers={publishedTeamMembers} />
    <TedxTeam heading="Speaker Team" image={ST} items={itemsS} teamMembers={publishedTeamMembers} />
    <TedxTeam heading="Tech & Graphic Team" image={TG} items={itemsTG} teamMembers={publishedTeamMembers} />
  </Container>
</Layout>
