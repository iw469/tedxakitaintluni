---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import tedxspark from "@/assets/tedx_logo_spark.png";
import { Image } from 'astro:assets';

const menuitems = [
  {
    title: "イベント情報",
    path: "#",
    children: [
      { title: "概要", path: "/#overview" },
      { title: "スケジュール", path: "/404" },
      { title: "会場案内", path: "/#route" },
      { title: "テーマ", path: "/#theme" },
      { title: "トークテーマ", path: "/#talktheme" },
      { title: "協賛企業", path: "/#sponsor" },
      { title: "運営委員会", path: "/#team" },
    ],
  },
  {
    title: "チケット情報",
    path: "/pricing",
  },
  {
    title: "Speakers",
    path: "/speaker",
  },
  {
    title: "TEDxAkitaIntlUとは",
    path: "/about",
  },
  {
    title: "Blog",
    path: "/404",
  },
  {
    title: "お問い合わせ",
    path: "/contact",
  },
];
---

<div class="w-full px-2 sm:px-6 lg:px-8 sticky top-0 z-50">
  <header class="flex flex-col lg:flex-row justify-between items-center h-14 mb-0 w-full">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="text-lg">
          <Image
            src={tedxspark}
            alt="TEDx Logo"
            class="h-14 w-auto"
          />
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-gray-800" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class="flex lg:px-3 py-2 items-center text-gray-600 hover:text-gray-900">
                      <span> {item.title}</span>
                      
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
      <!-- 
        <div class="lg:hidden flex items-center mt-3 gap-4">
          <Link href="#" style="muted" block size="md">Log in</Link>
          <Link href="#" size="md" block>Sign up</Link>
        </div>
        -->
      </MenuItems>
    </Astronav>
    <!-- 
    <div>
      <div class="hidden lg:flex items-center gap-4">
        <a href="#">Log in</a>
        <Link href="#" size="md">Sign up</Link>
      </div>
    </div>
    -->
  </header>
</div>
