---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import tedxspark from "@/assets/tedx_logo_spark.png";
import { alternateLocale, detectLocale, localizePath } from "@/utils/i18n";
import { Image } from 'astro:assets';

const locale = (Astro.props.locale === "en" ? "en" : detectLocale(Astro.url.pathname)) as "ja" | "en";
const targetLocale = alternateLocale(locale);
const languageButtonLabel = locale === "ja" ? "English" : "日本語";
const languageSwitchPath = localizePath(Astro.url.pathname, targetLocale);

const labels = {
  ja: {
    eventInfo: "イベント情報",
    overview: "概要",
    schedule: "スケジュール",
    venue: "会場案内",
    theme: "テーマ",
    talkTheme: "トークテーマ",
    sponsor: "協賛企業",
    team: "運営委員会",
    tickets: "チケット情報",
    about: "TEDxAkitaIntlUとは",
    contact: "お問い合わせ",
  },
  en: {
    eventInfo: "Event Info",
    overview: "Overview",
    schedule: "Schedule",
    venue: "Venue",
    theme: "Theme",
    talkTheme: "Talk Themes",
    sponsor: "Sponsors",
    team: "Team",
    tickets: "Tickets",
    about: "About TEDxAkitaIntlU",
    contact: "Contact",
  },
};

const text = labels[locale];

const menuitems = [
  {
    title: text.eventInfo,
    path: "#",
    children: [
      { title: text.overview, path: localizePath("/#overview", locale) },
      { title: text.schedule, path: localizePath("/404", locale) },
      { title: text.venue, path: localizePath("/#route", locale) },
      { title: text.theme, path: localizePath("/#theme", locale) },
      { title: text.talkTheme, path: localizePath("/#talktheme", locale) },
      { title: text.sponsor, path: localizePath("/#sponsor", locale) },
      { title: text.team, path: localizePath("/#team", locale) },
    ],
  },
  {
    title: text.tickets,
    path: localizePath("/pricing", locale),
  },
  {
    title: "Speakers",
    path: localizePath("/speaker", locale),
  },
  {
    title: text.about,
    path: localizePath("/about", locale),
  },
  {
    title: text.contact,
    path: localizePath("/contact", locale),
  },
];
---

<div class="w-full px-2 sm:px-6 lg:px-8 sticky top-0 z-50">
  <header class="flex flex-col lg:flex-row justify-between items-center h-14 mb-0 w-full">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href={localizePath("/", locale)} class="text-lg -ml-6 sm:-ml-7 lg:-ml-8">
          <Image
            src={tedxspark}
            alt="TEDx Logo"
            class="h-14 w-auto"
          />
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-gray-800" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class="flex lg:px-3 py-2 items-center text-gray-600 hover:text-gray-900">
                      <span> {item.title}</span>
                      
                    </a>
                  </li>
                )}
              </>
            ))
          }
          <li class="flex items-center lg:ml-2">
            <a
              href={languageSwitchPath}
              class="inline-flex items-center rounded-md border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 hover:border-gray-400 hover:text-gray-900"
            >
              <span>{languageButtonLabel}</span>
            </a>
          </li>
        </ul>
      <!-- 
        <div class="lg:hidden flex items-center mt-3 gap-4">
          <Link href="#" style="muted" block size="md">Log in</Link>
          <Link href="#" size="md" block>Sign up</Link>
        </div>
        -->
      </MenuItems>
    </Astronav>
    <!-- 
    <div>
      <div class="hidden lg:flex items-center gap-4">
        <a href="#">Log in</a>
        <Link href="#" size="md">Sign up</Link>
      </div>
    </div>
    -->
  </header>
</div>
