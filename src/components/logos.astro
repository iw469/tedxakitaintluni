---
// @ts-ignore
import { Icon } from "astro-icon/components";
import Yuri from "@/assets/Yuri.png";
import { Image } from 'astro:assets';
---

<div class="mt-24">
  <h2 class="text-center text-slate-500 text-4xl md:text-5xl font-bold">協賛企業</h2>
  <div class="flex gap-8 md:gap-20 items-center justify-center mt-10 flex-wrap">

    <a href="/yuri" class="inline-block">
      <Image src={Yuri} alt="Yuri" class="h-8 md:h-12 w-auto cursor-pointer" />
    </a>

  </div>
</div>
