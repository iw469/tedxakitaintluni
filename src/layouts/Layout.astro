---
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import { detectLocale } from "@/utils/i18n";
import "@fontsource-variable/inter/index.css";

import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
}

const siteUrl = Astro.site?.toString();
const canonicalURL = siteUrl
  ? new URL(Astro.url.pathname, siteUrl).toString()
  : undefined;

const resolvedImageWithDomain = siteUrl
  ? new URL("/opengraph.jpg", siteUrl).toString()
  : undefined;

const { title, description } = Astro.props;
const locale = detectLocale(Astro.url.pathname);

const makeTitle = title
  ? title + " | " + "Tedxakitaintluni"
  : "TEDxAkitaIntlU | TEDx Akita International University Event";

const seoDescription =
  description ??
  "TEDxAkitaIntlU is the TEDx event at Akita International University in Japan, sharing ideas worth spreading through talks, workshops, and community events.";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- <link rel="preload" as="image" href={src} alt="Hero" /> -->
    <SEO
      title={makeTitle}
      description={seoDescription}
      canonical={canonicalURL}
      twitter={{
        creator: "@tedxakitaintluni",
        site: "tedxakitaintluni",
        card: "summary_large_image",
      }}
      openGraph={
        canonicalURL && resolvedImageWithDomain
          ? {
              basic: {
                url: canonicalURL,
                type: "website",
                title: makeTitle,
                image: resolvedImageWithDomain,
              },
              image: {
                alt: "Homepage Screenshot",
              },
            }
          : undefined
      }
    />
  </head>
  <body>
    <Navbar locale={locale} />
    <slot />
    <Footer />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
