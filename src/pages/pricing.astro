---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import PricingCard from "@/components/pricing.astro";

const pricing = [
    {
    name: "AIU学部生・院生",
    price: "500円",
    popular: false,
    features: [],
    button: {
      text: "申し込み",
      link: "/404",
    },
  },
  {
    name: "一般",
    price: "950円",
    popular: true,
    features: [],
    button: {
      text: "申し込み",
      link: "/404",
    },
  },
  {
    name: "学生",
    price: "学生700円",
    popular: false,
    features: [],
    button: {
      text: "申し込み",
      link: "/404",
    },
  },
  
];
---

<Layout title="Pricing">
  <Container>
    <Sectionhead>
      <Fragment slot="title">チケット情報</Fragment>
      <Fragment slot="desc">
        <p>支払い方法は当日支払いのみとなっております。</p>
        <p>４月１日より申し込み開始です。</p>
      </Fragment>
    </Sectionhead>

    <div
      class="grid md:grid-cols-3 gap-10 mx-auto max-w-(--breakpoint-lg) mt-12">
      {pricing.map((item) => <PricingCard plan={item} />)}
    </div>
  </Container>
</Layout>
