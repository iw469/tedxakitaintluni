---
// @ts-ignore
import { Picture } from "astro:assets";
import blueball from "@/assets/blueball.png";
---

<div class="mt-16 md:mt-1.5 mb-12">

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 mt-8 items-start px-4 sm:px-2 md:px-0">
    <!-- Left: Image with Odyssey2025 Text -->
    <div class="flex flex-col items-center justify-start">
      <h3 class="text-3xl font-bold mb-6 text-gray-800"></h3>
      <div class="relative w-full max-w-sm aspect-square flex items-center justify-center">
        <Picture
          src={blueball}
          alt="Odyssey 2025"
          widths={[300, 500]}
          sizes="(max-width: 768px) calc(100vw - 32px), 50vw"
          loading="eager"
          format="avif"
          class="w-full h-full object-contain"
        />
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="text-4xl lg:text-4xl text-black drop-shadow-lg">
            Odyssey2024
          </span>
        </div>
      </div>
    </div>

    <!-- Right: YouTube Videos Grid -->
    <div class="flex flex-col items-center justify-start">
      <h3 class="text-3xl font-bold mb-6 text-gray-800 w-full text-center">イベント映像</h3>
      <div class="grid grid-cols-3 gap-4 w-full">
        <!-- Video 1 -->
        <div class="aspect-[5/4]">
          <iframe
            class="w-full h-full rounded-lg shadow-md"
            src="https://www.youtube.com/embed/z8tIGTF4zf8?si=IdEXkhKtEf3LUmKU"
            title="YouTube video 1"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen></iframe>
        </div>

        <!-- Video 2 -->
        <div class="aspect-[5/4]">
          <iframe
            class="w-full h-full rounded-lg shadow-md"
            src="https://www.youtube.com/embed/oQdtYbQ9Y7Q?si=CNi5ce09McZS2uYe"
            title="YouTube video 2"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen></iframe>
        </div>

        <!-- Video 3 -->
        <div class="aspect-[5/4]">
          <iframe
            class="w-full h-full rounded-lg shadow-md"
            src="https://www.youtube.com/embed/KGVT_sxDFRM?si=Z2pTFS50pPPPOlgc"
            title="YouTube video 3"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen></iframe>
        </div>

        <!-- Video 4 -->
        <div class="aspect-[5/4]">
          <iframe
            class="w-full h-full rounded-lg shadow-md"
            src="https://www.youtube.com/embed/kuJcburyZLw?si=MYD9HKc1p2kNznXL"
            title="YouTube video 4"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen></iframe>
        </div>

        <!-- Video 5 -->
        <div class="aspect-[5/4]">
          <iframe
            class="w-full h-full rounded-lg shadow-md"
            src="https://www.youtube.com/embed/uGW38PunD5w?si=apoE2MUU1DqQ2BrJ"
            title="YouTube video 5"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen></iframe>
        </div>

        <!-- Video 6 -->
        <div class="aspect-[5/4]">
          <iframe
            class="w-full h-full rounded-lg shadow-md"
            src="https://www.youtube.com/embed/J675OwbnAkc?si=AgwS0qDSID8XNSlI"
            title="YouTube video 6"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </div>
</div>
