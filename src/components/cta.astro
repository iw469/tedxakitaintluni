---
import Link from "./ui/link.astro";
import { localizePath } from "@/utils/i18n";

const locale = Astro.props.lang ?? "ja";
const isEn = locale === "en";
---

<div
  class="bg-black p-8 md:px-20 md:py-20 mt-20 mx-auto max-w-5xl rounded-lg flex flex-col items-center text-center">
  <h2 class="text-white text-4xl md:text-6xl tracking-tight">
    Spark2026
  </h2>
  <p class="text-slate-400 mt-4 text-lg md:text-xl">
    Organized by TEDxAkitaIntlU
  </p>
  <div class="flex mt-5">
    <Link href={localizePath("/pricing", locale)} style="inverted">{isEn ? "Get Your Ticket" : "チケットはこちらから！"}</Link>
  </div>
</div>
