---
// @ts-ignore
import { Picture } from "astro:assets";
import alumni from "@/assets/Alumni.jpg";
import { Icon } from "astro-icon/components";
---
<div class="mt-16 md:mt-1.5 mb-12">
<h2 id="route" class="text-4xl lg:text-5xl font-bold lg:tracking-tight ml-8 text-orange-400">
    会場案内
</h2>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-2 md:gap-4 mt-8 items-stretch px-2 sm:px-2 md:px-0">
    <!-- Left: Info Box (moved) -->
    <div class="order-2 lg:order-1 bg-gray-50 rounded-lg shadow-lg p-6 text-left">
        <h3 class="text-3xl font-bold mb-4 text-gray-800">行き方</h3>
        <div class="space-y-3 text-gray-700 text-base">
            <div>
                <span class="text-xl md:text-xl font-bold">【場所】</span>
                <span class="text-xl md:text-xl font-semibold ml-2">国際教養大学アラムナイホール</span><br/>
                <span class="text-xl md:text-xl font-semibold ml-2">〒010-1211 秋田県秋田市雄和椿川字奥椿岱 193-2</span>
            </div>
            <div>
                <span class="font-bold">【秋田駅から】</span> To be added
            </div>
            <div>
                <span class="font-bold">【イオンモールから】</span> To be added
            </div>
            
            
        </div>
    </div>
    <!-- Middle: Map -->
    <div class="order-3 lg:order-2 flex justify-center items-stretch w-full min-w-0 h-72 md:h-96">
        <iframe
            src="https://www.google.com/maps?q=%E5%9B%BD%E9%9A%9B%E6%95%99%E8%82%B2%E5%A4%A7%E5%AD%A6%E3%82%A2%E3%83%A9%E3%83%A0%E3%83%8A%E3%82%A4%E3%83%9B%E3%83%BC%E3%83%AB+193-2&output=embed"
            class="w-full h-full border-0 rounded-md"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
    </div>

    <!-- Right: Image (moved) -->
    <div class="order-1 lg:order-3 flex justify-end items-center w-full min-w-0 h-72 md:h-full">
        <Picture
            src={alumni}
            alt="Alumni Hall Picture"
            widths={[200, 400, 600]}
            sizes="(max-width: 768px) calc(100vw - 32px), 50vw"
            loading="eager"
            format="avif"
                class="w-auto max-w-full h-full object-contain"
        />
    </div>
</div>
<div id="sponsor"></div>