---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";

// Filter team entries with 'draft: false' & date before current date
const publishedTeamMembers = (
  await getCollection("team", ({ data }) => !data.draft && data.publishDate < new Date())
).sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const locale = Astro.props.lang ?? "ja";
const isEn = locale === "en";
---

<div class="flex flex-col gap-3 mx-auto max-w-4xl mt-16">
  <h2 id="team" class="font-bold text-4xl text-gray-800">
    {isEn ? "Organizing Team" : "運営委員会"}
  </h2>
</div>
<div class="grid md:grid-cols-3 gap-10 mx-auto max-w-4xl mt-12">
  {
    publishedTeamMembers.map((teamMemberEntry) => (
      <div class="group">
        <div class="w-full aspect-square">
          <Picture
            src={teamMemberEntry.data.avatar.src}
            alt={teamMemberEntry.data.avatar.alt}
            sizes="(max-width: 800px) 100vw, 400px"
            width={400}
            height={400}
            class="w-full rounded-sm transition group-hover:-translate-y-1 group-hover:shadow-xl bg-white object-cover object-center aspect-square"
          />
        </div>

        <div class="mt-4 text-center">
          <h2 class="text-xl text-gray-800">{teamMemberEntry.data.name}</h2>
          <h3 class="text-base text-slate-500">
            {(() => {
              const lines = teamMemberEntry.data.title
                ? teamMemberEntry.data.title.split('\n')
                : [];
              return lines.map((line, i) => (
                <>
                  {line}
                  {i !== lines.length - 1 ? <br /> : null}
                </>
              ));
            })()}
          </h3>
        </div>
      </div>
    ))
  }
</div>
